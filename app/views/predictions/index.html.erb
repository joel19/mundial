<% content_for :title, "Pronósticos" %>

<div class="page">
  <% if notice %>
    <p class="flash flash--notice"><%= notice %></p>
  <% end %>

  <div class="page__header">
    <h1>Pronósticos</h1>
  </div>

  <div class="match-list">
    <% @matches.each do |match| %>
      <% prediction = @predictions_by_match_id[match.id] %>
      <div class="match-row">
        <div class="match-row__teams">
          <span><%= match.home_team.name %></span>
          <span class="match-row__score"><%= match.home_team_score %> - <%= match.away_team_score %></span>
          <span><%= match.away_team.name %></span>
        </div>

        <% if prediction %>
          <div class="match-row__prediction">
            <span class="badge <%= prediction.correct? ? "badge--prediction-correct" : "badge--prediction-incorrect" %>">
              Tu pronóstico: <%= prediction.predicted_home_score %> - <%= prediction.predicted_away_score %>
            </span>
            <%= link_to "Editar", edit_prediction_path(prediction), class: "btn btn--secondary" %>
            <%= button_to "Eliminar", prediction, method: :delete, data: { turbo_confirm: "¿Seguro que deseas eliminar este pronóstico?" }, class: "btn btn--danger" %>
          </div>
        <% else %>
          <%= link_to "Pronosticar", new_prediction_path(match_id: match.id), class: "btn btn--primary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
